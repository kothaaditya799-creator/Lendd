# LendTrack Environment Configuration Example
# Copy this file to `.env.local` for local development (never commit `.env.local` or `.env`).
#
# SECURITY WARNING:
# Only place public/client-safe keys here (`VITE_*`).
# NEVER put your Supabase `service_role` secret key inside frontend Vite environment variables.

# Your Supabase Project URL (e.g., https://abcdefghijklmno.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase public `anon` key (used with Postgres Row-Level Security policies)
VITE_SUPABASE_ANON_KEY=

